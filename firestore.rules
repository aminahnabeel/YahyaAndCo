rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== USERS COLLECTION ====================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== BUSINESSES COLLECTION ====================
    match /businesses/{businessId} {
      // User must own this business (firebase_uid must match)
      allow read, write: if request.auth != null && resource.data.firebase_uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.firebase_uid == request.auth.uid;

      // ==================== ACCOUNTS SUBCOLLECTION ====================
      match /accounts/{accountId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
      }

      // ==================== TRANSACTIONS SUBCOLLECTION ====================
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
      }

      // ==================== JOURNAL ENTRIES SUBCOLLECTION ====================
      match /journal_entries/{journalId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;

        // ==================== JOURNAL LINES NESTED SUBCOLLECTION ====================
        match /journal_lines/{lineId} {
          allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
          allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        }
      }

      // ==================== EXPENSE CATEGORIES SUBCOLLECTION ====================
      match /expense_categories/{categoryId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
      }

      // ==================== NOTES SUBCOLLECTION ====================
      match /notes/{noteId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.firebase_uid == request.auth.uid;
      }
    }

    // ==================== DENY ALL BY DEFAULT ====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
